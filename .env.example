# neatlogs (free during neatHack). Use the PROJECT API key (not the nlw_ ingest key).
NEATLOGS_API_KEY=

# LLM — any OpenAI-compatible endpoint. Hackathon LiteLLM key or your own provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Crustdata — 5,000 hackathon credits (promo NEATLOGS-OCT2026, email signup).
CRUSTDATA_API_KEY=

# Optional: inject a failure into a stage to demo recovery (e.g. discover).
STAGEZERO_FAIL_AT=
STAGEZERO_FAIL_TIMES=1

STAGEZERO_RUNS_DIR=runs
